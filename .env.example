APP_NAME="Bulk WhatsApp Campaign"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MongoDB - Primary Database (Accounts, Templates, Campaigns)
MONGO_DB_DSN=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
MONGO_DB_DATABASE=bulk_campaign

# MySQL - Read Only (Voters Data)
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_DATABASE=voters_db
MYSQL_DB_USERNAME=root
MYSQL_DB_PASSWORD=
MYSQL_DB_PREFIX=

# Redis - Queue & Cache
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue
QUEUE_CONNECTION=redis

# Cloudinary - Media Storage
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_UPLOAD_PRESET=bulk_campaign

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Super Admin Default Credentials
SUPER_ADMIN_EMAIL=admin@bulkcampaign.com
SUPER_ADMIN_PASSWORD=admin123456

# Campaign Settings
CAMPAIGN_BATCH_SIZE=500
CAMPAIGN_RATE_LIMIT_PER_SECOND=80
CAMPAIGN_MAX_CONCURRENT_WORKERS=10
CAMPAIGN_RETRY_ATTEMPTS=3
CAMPAIGN_RETRY_DELAY=60
